generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./healthlink.db"
}

model Doctor {
  id            Int             @id @default(autoincrement())
  name          String
  specialty     String
  availability  String
  initials      String
  color         String
  consultations Consultation[]
}

model Patient {
  id           Int    @id @default(autoincrement())
  username     String @unique
  fullName     String
  passwordSalt String
  passwordHash String
}

model Consultation {
  id               String   @id @default(cuid())
  doctorId         Int
  consultationType String
  preferredTime    DateTime
  reason           String
  status           String
  createdAt        DateTime @default(now())
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([preferredTime])
}